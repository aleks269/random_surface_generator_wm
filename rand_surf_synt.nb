         RowBox[{"3", ".5"}]], ",", "1"}], "}"}]}], "]"}]}], ";"}],
  FontSize->14], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"Table", "[", 
