Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GaussianNoiseMatrix", "[", 
    RowBox[{"n_", ",", "mean_", ",", "stddev_", ",", "seed_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "matrix", "}"}], ",", 
     RowBox[{
      RowBox[{"RandomSeed", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"matrix", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"mean", ",", "stddev"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "matrix", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"UniformNoiseMatrix", "[", 
     RowBox[{"n_", ",", "min_", ",", "max_", ",", "seed_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "matrix", "}"}], ",", 
      RowBox[{
       RowBox[{"RandomSeed", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"matrix", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"UniformDistribution", "[", 
           RowBox[{"{", 
            RowBox[{"min", ",", "max"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "matrix", "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateRandomSurface", "[", 
    RowBox[{
    "gridSize_", ",", "spectralExponent_", ",", "desiredRoughness_", ",", 
     "desiredStdDev_", ",", "noiseMean_", ",", "noiseStdDev_", ",", 
     "uniformMin_", ",", "uniformMax_", ",", "seed_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coefficients", ",", "surface", ",", "scalingFactor", ",", 
       "stdDevSurface", ",", "g", ",", "h"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "=", 
       RowBox[{"GaussianNoiseMatrix", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", "gridSize"}], "+", "1"}], ",", "noiseMean", ",", 
         "noiseStdDev", ",", "seed"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       RowBox[{"UniformNoiseMatrix", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", "gridSize"}], "+", "1"}], ",", "uniformMin", ",", 
         "uniformMax", ",", "seed"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"coefficients", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "m2n2", "}"}], ",", 
           RowBox[{
            RowBox[{"m2n2", "=", 
             RowBox[{
              RowBox[{"m", "^", "2"}], "+", 
              RowBox[{"n", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"m2n2", "==", "0"}], ",", "0", ",", 
               RowBox[{
                RowBox[{"(", "m2n2", ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "spectralExponent"}], "/", "4"}], ")"}]}]}], 
              "]"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "Pi", " ", "I", " ", 
               RowBox[{"RandomReal", "[", "]"}]}], "]"}], " ", 
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"m", "+", "gridSize", "+", "1"}], ",", 
                RowBox[{"n", "+", "gridSize", "+", "1"}]}], "]"}], "]"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "Pi", " ", "I", " ", 
               RowBox[{"h", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"m", "+", "gridSize", "+", "1"}], ",", 
                  RowBox[{"n", "+", "gridSize", "+", "1"}]}], "]"}], "]"}]}], 
              "]"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "gridSize"}], ",", "gridSize"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "gridSize"}], ",", "gridSize"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"coefficients", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{"coefficients", ",", 
         RowBox[{
          RowBox[{"c_", "/;", 
           RowBox[{
            RowBox[{"Abs", "[", "c", "]"}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "10"}]}]}]}], ":>", 
          RowBox[{
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "+", 
           RowBox[{"I", " ", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}]}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"surface", "=", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{"coefficients", ",", 
           RowBox[{"FourierParameters", "->", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ",", 
        RowBox[{"InverseFourier", "::", "fftl"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stdDevSurface", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"StandardDeviation", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Abs", "[", "surface", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"stdDevSurface", ">", "0"}], ",", 
        RowBox[{
         RowBox[{"scalingFactor", "=", 
          RowBox[{"desiredStdDev", "/", "stdDevSurface"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"surface", "=", 
          RowBox[{
           RowBox[{"Abs", "[", "surface", "]"}], "*", "scalingFactor"}]}], 
         ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Abs", "[", "surface", "]"}], "]"}], ";"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.935218665496374*^9, 3.935218780218441*^9}, {
   3.935218837946701*^9, 3.935218840371496*^9}, 3.935218898728819*^9, 
   3.935218953558426*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"3bec258c-44d1-5a4a-914e-ebe2d1ea7ba9"],

