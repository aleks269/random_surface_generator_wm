      RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], "&"}], "/@", 
   "results"}],
  FontSize->14], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"a", "=", 
    RowBox[{"results", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}],
  FontSize->14], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"#", "//", "Flatten"}], ",", "25", ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", "All"}], "}"}]}]}], "]"}], "&"}], "/@", "a"}],
  FontSize->14], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"statistics", "=", 
