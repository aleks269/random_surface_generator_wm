Cell[BoxData[{
 StyleBox[
  RowBox[{"ClearAll", "[", 
   RowBox[{"paramsList", ",", "results", ",", "a", ",", "statistics"}], "]"}],
  FontSize->14], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"paramsList", "=", 
